# Production settings, loaded by `next build` only — `next dev` ignores this
# file, so local development serves from http://localhost:3000/.
#
# Published at https://chtc.github.io/discovery-kiosk/.
# If you change NEXT_PUBLIC_BASE_PATH, also change BASE_PATH in the
# link-check job of .github/workflows/nextjs.yml.
NEXT_PUBLIC_BASE_PATH=/discovery-kiosk
HOSTNAME=chtc.github.io
